# Copie para .env.local para desenvolvimento. Na Vercel, use Environment Variables.
# Não publique valores reais no GitHub. Não use o prefixo NEXT_PUBLIC_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Senha exclusiva do painel: no mínimo 16 caracteres.
ADMIN_PASSWORD=
# Chave aleatória para proteger as sessões: no mínimo 32 caracteres.
SESSION_SECRET=
