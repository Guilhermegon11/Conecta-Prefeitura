# Copie para .env.local em desenvolvimento. Na Vercel, use Environment Variables.
# Não publique valores reais no GitHub. Não use o prefixo NEXT_PUBLIC_.

# Obrigatórias para entrar no painel e salvar respostas.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Teste ativo por padrão. Respostas de teste ficam separadas e nunca são públicas.
TEST_MODE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Opcional SOMENTE no teste: se omitida, é gerada e persistida no banco.
SESSION_SECRET=

# Para coleta real: TEST_MODE=false, ADMIN_PASSWORD com 16+ caracteres e
# SESSION_SECRET aleatória com 32+ caracteres. Gere valores com pnpm setup:keys.
